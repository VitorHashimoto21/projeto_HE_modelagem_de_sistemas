# Health Enterprise — variáveis de ambiente (SPEC-001)
# Copie para .env e preencha. O .env nunca vai para o Git.
# Cada ambiente (desenvolvimento, preview/homologação, produção) tem os próprios valores (RNF11).

# Conexão usada pela aplicação. No Supabase: a string do "Transaction pooler" (porta 6543).
# Em desenvolvimento: o PostgreSQL local do docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/he_dev"

# Conexão direta, usada só pelas migrações (prisma migrate). No Supabase: a "Direct connection"
# (porta 5432). Em desenvolvimento pode ficar vazia (vale a DATABASE_URL).
DIRECT_URL=""

# Banco de sombra do `prisma migrate dev` (só desenvolvimento).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/he_shadow"

# Banco dos testes de integração: PostgreSQL local com "test" no nome (nunca o Supabase).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/he_test"
