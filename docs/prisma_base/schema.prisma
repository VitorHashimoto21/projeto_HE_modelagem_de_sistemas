// ==========================================================
// ERP + Calculadora de Precificação — Schema Prisma (revisado)
// Correções em relação à v1: datasource/generator vazios,
// models faltantes (Cliente, HistoricoPreco, Parcela,
// ContaPagarReceber), campos livres convertidos em enum,
// tabela de parâmetros tributários (RNF08/RN17) e vínculo
// de auditoria em MovimentacaoEstoque (RNF05).
// v3: markup completo (RF34, RF48–RF57): DespesaFixa, parâmetros de
// precificação no Negocio, comissão opcional no Item, auditoria de
// usuário em HistoricoPreco; Lancamento renomeado p/ LancamentoFinanceiro.
// v4: cadastro via CNPJ/CNAE e Anexo do Simples por negócio (RF58, RF59, RN24),
// parâmetros fiscais oficiais (RN17), MEI/DAS (RF60, RF61), CMV% (RF62),
// preço opcional com origem (RF64, RN23), quitação de conta gera lançamento (RN22).
// v5: cancelamento/troca de venda (RF65, RF66, RN25, RN26), contas mensais de
// despesas fixas e DAS (RF67), estoque mínimo por cobertura (RF20), LGPD (RN27).
// v6: Fator R (RF69, RN28), permissões módulo × ação (RF06), datas em UTC com
// competência em America/Sao_Paulo (RN29).
// ==========================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================================
// Enums
// ==========================================================

enum PapelUsuario {
  DONO
  GERENTE
  COLABORADOR
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
}

enum PlanoNegocio {
  GRATUITO
  PAGO
}

enum TipoItem {
  PRODUTO_FISICO
  SERVICO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA_VENDA
  SAIDA_MANUAL
  ENTRADA_ESTORNO // RN25: devolução de estoque por cancelamento de venda
}

// RF17: motivo obrigatório apenas quando tipo = SAIDA_MANUAL (validar na aplicação)
enum MotivoSaidaManual {
  PERDA
  QUEBRA
  USO_INTERNO
  DOACAO
  OUTRO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  CREDITO_TROCA // RN26: crédito da venda original cancelada; não gera lançamento
}

// RF65: status da venda (nunca é apagada)
enum StatusVenda {
  CONCLUIDA
  CANCELADA
}

// RF60/RF67: origem da despesa fixa (DAS é criado e mantido pelo sistema para MEI)
enum OrigemDespesaFixa {
  MANUAL
  DAS_MEI
}

// RF59/RN24: Anexos do Simples Nacional (LC 123/2006)
enum AnexoSimples {
  I
  II
  III
  IV
  V
}

// RF60: tipo de atividade do MEI (define o valor do DAS)
enum AtividadeMei {
  COMERCIO_INDUSTRIA
  SERVICOS
  COMERCIO_E_SERVICOS
}

// RF64: origem do preço oficial
enum OrigemPreco {
  CALCULADORA
  MANUAL
}

enum CategoriaItem {
  SERVICOS
  PRODUTOS
  ALIMENTACAO
  VESTUARIO
  BELEZA
  SAUDE
  CASA
  TECNOLOGIA
  OUTROS
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

// RF32: categorias fixas de lançamento financeiro
enum CategoriaLancamento {
  VENDAS
  FORNECEDORES
  IMPOSTOS
  SALARIO
  OUTROS
}

enum TipoConta {
  PAGAR
  RECEBER
}

enum StatusConta {
  ABERTA
  PARCIAL
  QUITADA
  CANCELADA // RN25: conta a receber de venda cancelada
}

// ==========================================================
// Multi-tenancy
// ==========================================================

model Usuario {
  id    String @id @default(uuid()) @db.Uuid
  nome  String
  email String @unique
  senha String // RNF03: armazenar com hash seguro (Argon2/Bcrypt)

  // RNF04: consentimento explícito de uso de dados (LGPD)
  consentimentoLgpdEm DateTime?
  excluidoEm          DateTime? // RN27: acesso bloqueado
  anonimizadoEm       DateTime? // RN27: nome/e-mail/senha substituídos por valores anônimos

  membroEm         MembroNegocio[]
  movimentacoes    MovimentacaoEstoque[] // RNF05: auditoria (quem fez a alteração)
  historicoPrecos  HistoricoPreco[] // RNF05: auditoria (quem confirmou o preço)
  vendasCanceladas Venda[]               @relation("VendaCanceladaPor") // RF65: auditoria do cancelamento
  createdAt        DateTime              @default(now())
}

model Negocio {
  id               String           @id @default(uuid()) @db.Uuid
  nome             String
  regimeTributario RegimeTributario @default(MEI)
  plano            PlanoNegocio     @default(GRATUITO) // RF45
  createdAt        DateTime         @default(now())

  // Dados fiscais obtidos pela consulta de CNPJ ou informados manualmente (RF58, RF59)
  cnpj          String?       @unique
  razaoSocial   String?
  cnaePrincipal String?
  anexoSimples  AnexoSimples? // RN24: um anexo por negócio (Simples Nacional)
  sujeitoFatorR Boolean       @default(false) // RF69: herdado do CNAE; anexo efetivo III/V calculado pelo Fator R
  atividadeMei  AtividadeMei? // RF60: usado quando regimeTributario = MEI

  // Parâmetros de precificação (RF49–RF51, RF56, RF62)
  taxaCartaoMedia           Decimal  @default(0) @db.Decimal(5, 2) // RF51: % médio da maquininha
  margemLucroMeta           Decimal? @db.Decimal(5, 2) // RF56: margem desejada p/ faturamento meta
  capacidadeMensal          Decimal? @db.Decimal(10, 2) // RF50: horas/atendimentos/unidades por mês
  ticketMedioEstimado       Decimal? @db.Decimal(10, 2) // RF50
  faturamentoMensalEstimado Decimal? @db.Decimal(12, 2) // RF50: recomendado = capacidade × ticket, editável
  cmvEstimado               Decimal? @db.Decimal(5, 2) // RF62: CMV% usado enquanto não há histórico
  diasCoberturaEstoque      Int      @default(7) // RF20: estoque mínimo = ⌈consumo médio diário × dias⌉

  encerradoEm DateTime? // RN27: negócio encerrado após exclusão do único Dono (dados fiscais retidos 5 anos)

  membros       MembroNegocio[]
  itens         Item[]
  vendas        Venda[]
  lancamentos   LancamentoFinanceiro[]
  contas        ContaPagarReceber[]
  clientes      Cliente[]
  despesasFixas DespesaFixa[]

  @@index([id])
}

model MembroNegocio {
  id               String       @id @default(uuid()) @db.Uuid
  usuarioId        String       @db.Uuid
  negocioId        String       @db.Uuid
  papel            PapelUsuario @default(COLABORADOR) // RF05
  permissoesCustom Json? // RF06: matriz módulo × ação, ex. {"financeiro": {"ver": false, "criar": true}}

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@unique([usuarioId, negocioId])
}

// ==========================================================
// Clientes
// ==========================================================

// Referenciado em Negocio.clientes e Venda.cliente na v1, mas nunca definido — adicionado agora.
model Cliente {
  id            String    @id @default(uuid()) @db.Uuid
  negocioId     String    @db.Uuid
  nome          String
  contato       String?
  anonimizadoEm DateTime? // RN27

  negocio Negocio @relation(fields: [negocioId], references: [id])
  vendas  Venda[]

  @@index([negocioId])
}

// ==========================================================
// Catálogo e estoque
// ==========================================================

model Item {
  id            String        @id @default(uuid()) @db.Uuid
  negocioId     String        @db.Uuid
  tipo          TipoItem
  nome          String
  categoria     CategoriaItem // RF11
  unidadeMedida String // RF10
  custoBase     Decimal       @db.Decimal(10, 2)
  precoAtual    Decimal?      @db.Decimal(10, 2) // RF64/RN15: último preço confirmado; null = não vendável (RN23)

  // Campos específicos de Produto Físico — irrelevantes para Servico,
  // participação no Estoque é determinada pelo campo `tipo` (RN04),
  // validar na camada de aplicação.
  quantidadeEstoque Decimal  @default(0) @db.Decimal(10, 3) // RN03: nasce zerado
  estoqueMinimo     Decimal? @db.Decimal(10, 3) // RF08/RF20: opcional, sugerido após 1º ciclo (RN07/RN08)

  comissaoPercentual Decimal? @db.Decimal(5, 2) // RF52: opcional (null = 0%), entra como despesa variável

  negocio         Negocio               @relation(fields: [negocioId], references: [id])
  movimentacoes   MovimentacaoEstoque[]
  historicoPrecos HistoricoPreco[]
  materiais       MaterialServico[]     @relation("ServicoParaMaterial")
  usadoEm         MaterialServico[]     @relation("MaterialParaServico")
  itensVenda      ItemVenda[]

  @@index([negocioId])
}

model MaterialServico {
  id         String  @id @default(uuid()) @db.Uuid
  servicoId  String  @db.Uuid
  materialId String  @db.Uuid // referencia um Produto Físico já cadastrado
  quantidade Decimal @default(1) @db.Decimal(10, 3) // RF13: sugestão automática de 1, editável

  servico  Item @relation("ServicoParaMaterial", fields: [servicoId], references: [id])
  material Item @relation("MaterialParaServico", fields: [materialId], references: [id])

  @@unique([servicoId, materialId])
}

model MovimentacaoEstoque {
  id         String             @id @default(uuid()) @db.Uuid
  itemId     String             @db.Uuid
  tipo       TipoMovimentacao
  quantidade Decimal            @db.Decimal(10, 3)
  motivo     MotivoSaidaManual? // RF17: obrigatório apenas quando tipo = SAIDA_MANUAL
  usuarioId  String             @db.Uuid // RNF05: auditoria
  data       DateTime           @default(now())

  item    Item    @relation(fields: [itemId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([itemId])
}

// Referenciado em Item.historicoPrecos na v1, mas nunca definido — adicionado agora.
// Cada linha = uma confirmação explícita do usuário na Calculadora (RN15/RN16).
// Guarda todos os componentes do markup (RF34) para auditoria (RNF05).
model HistoricoPreco {
  id                          String            @id @default(uuid()) @db.Uuid
  itemId                      String            @db.Uuid
  usuarioId                   String            @db.Uuid // RNF05: quem confirmou
  preco                       Decimal           @db.Decimal(10, 2)
  origem                      OrigemPreco       @default(CALCULADORA) // RF64: campos do cálculo ficam nulos quando MANUAL
  margemAplicada              Decimal?          @db.Decimal(5, 2) // percentual usado no cálculo
  custoConsiderado            Decimal?          @db.Decimal(10, 2) // custo total no momento (RF35: já soma materiais)
  despesasFixasPercentual     Decimal?          @db.Decimal(5, 2) // RF49
  despesasVariaveisPercentual Decimal?          @db.Decimal(5, 2) // RN20: taxa cartão + comissão
  regimeTributario            RegimeTributario?
  impostoAplicado             Decimal?          @db.Decimal(5, 2) // alíquota efetiva utilizada
  dataConfirmacao             DateTime          @default(now())

  item    Item    @relation(fields: [itemId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([itemId])
}

// ==========================================================
// Despesas fixas mensais (RF48) — base de Desp. Fixas% (RF49) e do PE (RF55)
// ==========================================================

model DespesaFixa {
  id            String              @id @default(uuid()) @db.Uuid
  negocioId     String              @db.Uuid
  descricao     String
  valorMensal   Decimal             @db.Decimal(10, 2)
  diaVencimento Int                 @default(10) // RF67: dia do mês da conta a pagar gerada
  categoria     CategoriaLancamento @default(OUTROS) // RF67: ex. SALARIO, IMPOSTOS (DAS)
  origem        OrigemDespesaFixa   @default(MANUAL)
  ativo         Boolean             @default(true)
  createdAt     DateTime            @default(now())

  negocio Negocio             @relation(fields: [negocioId], references: [id])
  contas  ContaPagarReceber[] // RF67: uma conta a pagar por mês

  @@index([negocioId])
}

// ==========================================================
// Parâmetros tributários (RNF08 / RN17)
// Faixas de RBT12 e alíquota parametrizáveis sem deploy de código.
// ==========================================================

// Somente Simples Nacional: faixas por Anexo (LC 123/2006). MEI usa ParametroMei.
model FaixaTributaria {
  id             String       @id @default(uuid()) @db.Uuid
  anexo          AnexoSimples
  faixaOrdem     Int // 1ª a 6ª faixa
  rbt12De        Decimal      @db.Decimal(12, 2)
  rbt12Ate       Decimal?     @db.Decimal(12, 2) // null = sem teto (última faixa)
  aliquota       Decimal      @db.Decimal(5, 2) // percentual nominal
  parcelaDeduzir Decimal      @db.Decimal(12, 2) // RF38: alíquota efetiva = (RBT12 × aliquota − parcelaDeduzir) ÷ RBT12
  fonteLegal     String // RN17: ex. "LC 123/2006, Anexo III"
  vigenteDesde   DateTime     @default(now())
  ativo          Boolean      @default(true)

  @@index([anexo, ativo])
}

// RF59: tabela oficial CNAE → Anexo (Resolução CGSN 140/2018), usada para sugerir o anexo do negócio
model CnaeAnexo {
  cnae          String       @id // código CNAE (subclasse)
  descricao     String
  anexo         AnexoSimples // anexo base (V para CNAEs sujeitos ao Fator R)
  sujeitoFatorR Boolean      @default(false) // RF69
  fonteLegal    String
  vigenteDesde  DateTime     @default(now())
}

// RF60/RF61: valor mensal do DAS e limite anual do MEI
model ParametroMei {
  id                     String       @id @default(uuid()) @db.Uuid
  atividade              AtividadeMei
  valorDasMensal         Decimal      @db.Decimal(10, 2)
  limiteFaturamentoAnual Decimal      @db.Decimal(12, 2)
  fonteLegal             String
  vigenteDesde           DateTime     @default(now())
  ativo                  Boolean      @default(true)

  @@index([atividade, ativo])
}

// RF36: margem padrão por categoria, inicializada com percentuais de presunção (Lei 9.249/1995, art. 15)
model MargemPadraoCategoria {
  categoria    CategoriaItem @id
  margemPadrao Decimal       @db.Decimal(5, 2)
  fonteLegal   String
  vigenteDesde DateTime      @default(now())
}

// ==========================================================
// Vendas e financeiro
// ==========================================================

model Venda {
  id         String   @id @default(uuid()) @db.Uuid
  negocioId  String   @db.Uuid
  clienteId  String?  @db.Uuid // RF22: opcional
  data       DateTime @default(now())
  valorTotal Decimal  @db.Decimal(10, 2)

  // RF65/RN25: cancelamento (a venda nunca é apagada)
  status             StatusVenda @default(CONCLUIDA)
  canceladaEm        DateTime?
  canceladaPorId     String?     @db.Uuid
  motivoCancelamento String?
  vendaOrigemId      String?     @unique @db.Uuid // RF66: troca — nova venda aponta para a venda cancelada

  negocio      Negocio                @relation(fields: [negocioId], references: [id])
  cliente      Cliente?               @relation(fields: [clienteId], references: [id])
  canceladaPor Usuario?               @relation("VendaCanceladaPor", fields: [canceladaPorId], references: [id])
  vendaOrigem  Venda?                 @relation("TrocaDeVenda", fields: [vendaOrigemId], references: [id])
  vendaTroca   Venda?                 @relation("TrocaDeVenda")
  itens        ItemVenda[]
  pagamentos   Pagamento[]
  lancamentos  LancamentoFinanceiro[] // RN12 — 1:N: pagamento misto pode gerar mais de um lançamento imediato

  @@index([negocioId])
  @@index([negocioId, data, status]) // AD-QA01/RN21/RN25: RBT12 e faturamento somam só vendas CONCLUIDA
}

model ItemVenda {
  id            String  @id @default(uuid()) @db.Uuid
  vendaId       String  @db.Uuid
  itemId        String  @db.Uuid
  quantidade    Decimal @db.Decimal(10, 3)
  precoUnitario Decimal @db.Decimal(10, 2)
  custoUnitario Decimal @db.Decimal(10, 2) // RF62: custo total do item (inclui materiais) no momento da venda

  venda Venda @relation(fields: [vendaId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])
}

model Pagamento {
  id       String         @id @default(uuid()) @db.Uuid
  vendaId  String         @db.Uuid
  forma    FormaPagamento
  valor    Decimal        @db.Decimal(10, 2)
  parcelas Int            @default(1) // RF27: até 12x, só relevante para CREDITO

  venda           Venda     @relation(fields: [vendaId], references: [id])
  detalheParcelas Parcela[]
}

// Referenciado em Pagamento.detalheParcelas na v1, mas nunca definido — adicionado agora.
// Só é populado quando forma = CREDITO (Dinheiro/PIX/Débito não geram Parcela).
model Parcela {
  id          String   @id @default(uuid()) @db.Uuid
  pagamentoId String   @db.Uuid
  numero      Int
  valor       Decimal  @db.Decimal(10, 2)
  vencimento  DateTime // RF28: mensal, a partir da data da venda; RN11: centavos de diferença na 1ª parcela
  // Sem status próprio: a situação de pagamento é o status da ContaPagarReceber (RN22)

  pagamento Pagamento          @relation(fields: [pagamentoId], references: [id])
  conta     ContaPagarReceber? // RN10: cada parcela origina uma conta a receber

  @@index([pagamentoId])
}

model LancamentoFinanceiro {
  id        String              @id @default(uuid()) @db.Uuid
  negocioId String              @db.Uuid
  vendaId   String?             @db.Uuid // RN09: lançamento imediato de venda
  contaId   String?             @db.Uuid // RN22: pagamento/recebimento de conta
  tipo      TipoLancamento
  categoria CategoriaLancamento // RF32
  valor     Decimal             @db.Decimal(10, 2)
  estorno   Boolean             @default(false) // RN25: saída que estorna valor recebido de venda cancelada
  data      DateTime            @default(now())

  negocio Negocio            @relation(fields: [negocioId], references: [id])
  venda   Venda?             @relation(fields: [vendaId], references: [id])
  conta   ContaPagarReceber? @relation(fields: [contaId], references: [id])

  @@index([negocioId])
  @@index([contaId])
}

// Referenciado em Negocio.contas na v1, mas nunca definido — adicionado agora.
// RF30/RF31: contas a pagar/receber com vencimento e quitação parcial.
// "Atrasada" não é persistida: é derivada (vencimento < hoje E valorPago < valorTotal).
model ContaPagarReceber {
  id            String              @id @default(uuid()) @db.Uuid
  negocioId     String              @db.Uuid
  parcelaId     String?             @unique @db.Uuid // preenchido quando originada de uma Parcela de cartão (RN10)
  despesaFixaId String?             @db.Uuid // RF67: conta gerada a partir de despesa fixa (ou DAS)
  competencia   DateTime? // RF67: 1º dia do mês de referência
  tipo          TipoConta
  categoria     CategoriaLancamento // RF30/RN13: contas de venda usam VENDAS
  descricao     String?
  valorTotal    Decimal             @db.Decimal(10, 2)
  valorPago     Decimal             @default(0) @db.Decimal(10, 2) // RF31
  vencimento    DateTime
  status        StatusConta         @default(ABERTA)

  negocio     Negocio                @relation(fields: [negocioId], references: [id])
  parcela     Parcela?               @relation(fields: [parcelaId], references: [id])
  despesaFixa DespesaFixa?           @relation(fields: [despesaFixaId], references: [id])
  lancamentos LancamentoFinanceiro[] // RN22: cada pagamento parcial/total gera um lançamento

  @@unique([despesaFixaId, competencia]) // RF67: não duplicar a conta do mesmo mês
  @@index([negocioId])
}
